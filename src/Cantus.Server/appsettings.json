{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "TrustAllProxies": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "ConnectionStrings": {
    "CantusDatabase": "Data Source=cantus.db"
  },
  "Spotify": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "http://localhost:5000/api/auth/spotify/callback",
    "Scopes": [
      "user-read-playback-state",
      "user-read-currently-playing",
      "user-modify-playback-state",
      "user-read-private",
      "user-read-email"
    ]
  },
  "Lrclib": {
    "BaseUrl": "https://lrclib.net",
    "UserAgent": "CantusSyncedLyrics/1.0.0 (https://github.com/jav76/Cantus)",
    "TimeoutSeconds": 8
  },
  "LyricsCache": {
    "NegativeCacheDays": 30
  },
  "CoverArt": {
    "Enabled": true,
    "MusicBrainzBaseUrl": "https://musicbrainz.org",
    "CoverArtArchiveBaseUrl": "https://coverartarchive.org",
    "UserAgent": "CantusSyncedLyrics/1.0.0 ( https://github.com/jav76/Cantus )",
    "TimeoutSeconds": 10,
    "CacheDays": 90,
    "NegativeCacheDays": 30
  },
  "Netease": {
    "Enabled": true,
    "BaseUrl": "https://music.163.com",
    "TimeoutSeconds": 10,
    "SearchLimit": 10,
    "DurationToleranceSeconds": 5
  },
  "PlaybackPoller": {
    "ActivePollIntervalMs": 4000,
    "ApproachingEndPollIntervalMs": 2500,
    "ImminentEndPollIntervalMs": 1200,
    "ApproachingEndThresholdMs": 15000,
    "ImminentEndThresholdMs": 5000,
    "PausedPollIntervalMs": 5000,
    "PausedExtendedPollIntervalMs": 15000,
    "PausedDeepPollIntervalMs": 30000,
    "IdlePollIntervalMs": 10000,
    "IdleExtendedPollIntervalMs": 30000,
    "IdleDeepPollIntervalMs": 60000,
    "BackgroundPollIntervalMs": 20000,
    "DiagnosticsBroadcastIntervalMs": 5000
  },
  "DisplayPairing": {
    "CodeLength": 8,
    "CodeLifetimeSeconds": 300,
    "MaxPendingPairings": 1000,
    "RateLimitPermitLimit": 10,
    "RateLimitWindowSeconds": 60
  },
  "SongLookup": {
    "ExternalSearchEnabled": true,
    "LrclibTitleGuessEnabled": true,
    "OnlineLookupsPerMinute": 6,
    "LrclibRequestsPerMinute": 10,
    "NeteaseRequestsPerMinute": 6,
    "SearchPermitLimit": 20,
    "PlayPermitLimit": 12,
    "RateLimitWindowSeconds": 60
  }
}
