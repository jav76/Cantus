<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <WasmShellIndexHtmlPath>WasmScripts\index.html</WasmShellIndexHtmlPath>
    <TargetFrameworks Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">net10.0-browserwasm;net10.0-desktop;net10.0-windows10.0.26100</TargetFrameworks>
    <TargetFrameworks Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'false'">net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-desktop'">win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!-- Display name -->
    <ApplicationTitle>Cantus</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.cantus.lyrics</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Cantus</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Cantus - Real-Time Spotify Synced Lyrics Platform</Description>

    <!-- Figtree (Assets/Fonts) is the default text font, set in App's static constructor. -->
    <UnoDefaultFont>None</UnoDefaultFont>
    <UnoFeatures>
      Material;
      Toolkit;
    </UnoFeatures>
  </PropertyGroup>

  <!-- [JSImport] interop for the VU meter's browser audio source. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cantus.Core\Cantus.Core.csproj" />
    <ProjectReference Include="..\..\Cantus.Generators\Cantus.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="System.CommandLine" />
    <InternalsVisibleTo Include="Cantus.Client.Tests" />
  </ItemGroup>


  <ItemGroup>
    <!-- The icon paths are compiled in (Icons/CantusIcons.g.cs); their licence ships as a file like the font licences. -->
    <Content Include="Icons\LICENSE-Phosphor.txt" />
  </ItemGroup>

  <!-- WASAPI loopback for the VU meter on Windows (desktop and WinUI heads); only loaded on Windows. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-browserwasm'">
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>

  <!-- MPRIS on the desktop head. Pinned to the version Uno's X11 host is built against. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <EmbeddedResource Include="WasmScripts\AppManifest.js" />
  </ItemGroup>
</Project>
