<UserControl x:Class="Cantus.Client.Views.AdaptiveTrackCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cantus.Client"
             xmlns:views="using:Cantus.Client.Views"
             xmlns:services="using:Cantus.Client.Services"
             xmlns:vm="using:Cantus.Client.ViewModels"
             xmlns:models="using:Cantus.Client.Models">

    <Border Background="{x:Bind Theme.SurfaceCardBrush, Mode=OneWay}"
            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="{x:Bind GetCardPadding(Layout.CurrentBreakpoint), Mode=OneWay}">
        <Grid>
            <!-- Standard / Desktop / Tablet Card Layout -->
            <!-- The scroller extends 12px into the card's right padding and the content gets a
                 matching right margin, so the scrollbar sits in that gutter instead of drawing
                 over the buttons and sliders. -->
            <ScrollViewer x:Name="StandardCardScroller"
                          Margin="0,0,-12,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{x:Bind GetStandardCardVisibility(Layout.CurrentBreakpoint), Mode=OneWay}">
                <StackPanel Margin="0,0,12,0"
                            Spacing="{x:Bind GetCardSpacing(Layout.CurrentBreakpoint), Mode=OneWay}">
                    <views:NowPlayingPanel ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                           Scroller="{x:Bind StandardCardScroller}" />

                    <!-- Splits the player from the settings sections below -->
                    <Border Style="{StaticResource CantusHairlineStyle}" />

                    <!-- Manual Sync Offset Adjuster -->
                    <StackPanel Spacing="10" Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="Sync offset" VerticalAlignment="Center" Style="{StaticResource CantusSectionLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Timing.OffsetText, Mode=OneWay}" FontSize="12" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" Content="-0.5s" Click="OnNudgeMinus500Clicked" Background="#20FFFFFF" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                            <Button Grid.Column="1" Content="-0.1s" Click="OnNudgeMinus100Clicked" Background="#20FFFFFF" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                            <Button Grid.Column="2" Content="Reset" Click="OnResetOffsetClicked" Background="#20FFFFFF" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                            <Button Grid.Column="3" Content="+0.1s" Click="OnNudgePlus100Clicked" Background="#20FFFFFF" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                            <Button Grid.Column="4" Content="+0.5s" Click="OnNudgePlus500Clicked" Background="#20FFFFFF" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                        </Grid>
                    </StackPanel>

                    <!-- Paired Display -->
                    <StackPanel Spacing="8" Visibility="{x:Bind Pairing.DisplayInfoVisibility, Mode=OneWay}">
                        <TextBlock Text="Display" Style="{StaticResource CantusSectionLabelStyle}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <views:CantusIcon Grid.Column="0" Kind="Display" Size="17" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Pairing.DisplayName, Mode=OneWay}" FontSize="13" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Paired display (view only)" FontSize="11" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Wrong Lyrics Picker (owner only) -->
                    <Button Click="OnWrongLyricsClicked"
                            Visibility="{x:Bind GetLyricsPickerVisibility(Pairing.OwnerControlsVisibility, LyricsPicker.ActionVisibility), Mode=OneWay}"
                            HorizontalAlignment="Stretch"
                            Background="#15FFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="10"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <views:CantusIcon Kind="Edit" Size="15" />
                            <TextBlock Text="Wrong lyrics?" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- Account: a Spotify Session or this computer's players -->
                    <StackPanel Spacing="8" Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}">
                        <TextBlock Text="Account" Style="{StaticResource CantusSectionLabelStyle}" />

                        <!-- Logged in state -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Visibility="{x:Bind Session.HasSessionsVisibility, Mode=OneWay}">
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#20FFFFFF" Margin="0,0,10,0">
                                <views:CantusIcon Kind="{x:Bind Session.AccountIcon, Mode=OneWay}" Size="17" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Session.ActiveUserName, Mode=OneWay}" FontSize="13" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Session.AccountSourceText, Mode=OneWay}" FontSize="11" Foreground="#10B981" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Click="OnAccountClicked"
                                    Background="#1AFFFFFF"
                                    Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    ToolTipService.ToolTip="Switch or sign out">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <views:CantusIcon Kind="SignOut" Size="14" />
                                    <views:CantusIcon Kind="ChevronDown" Size="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Not logged in state -->
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" Visibility="{x:Bind Session.NoSessionsVisibility, Mode=OneWay}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Not Connected" FontSize="13" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" />
                                <TextBlock Text="Log in to view lyrics" FontSize="11" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
                                <Button Click="OnUseLocalPlayersClicked"
                                        Visibility="{x:Bind Session.LocalChoiceVisibility, Mode=OneWay}"
                                        IsEnabled="{x:Bind Session.CanUseLocalPlayers, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        Background="#1AFFFFFF"
                                        BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                                        BorderThickness="1"
                                        Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                                        CornerRadius="6"
                                        Padding="10,5"
                                        ToolTipService.ToolTip="Follow the media players on this computer, no Spotify account needed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <views:CantusIcon Kind="Display" Size="13" />
                                        <TextBlock Text="Use this computer's players" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnPairAsDisplayClicked"
                                        HorizontalAlignment="Stretch"
                                        Background="#1AFFFFFF"
                                        BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                                        BorderThickness="1"
                                        Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                                        CornerRadius="6"
                                        Padding="10,5"
                                        ToolTipService.ToolTip="Show a code an owner approves from a signed-in device">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <views:CantusIcon Kind="Display" Size="13" />
                                        <TextBlock Text="Pair as display" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Click="OnConnectSpotifyClicked"
                                    Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                                    Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    FontFamily="{StaticResource CantusTextSemiBoldFontFamily}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <views:CantusIcon Kind="SpotifyConnect" Size="13" />
                                    <TextBlock Text="Connect" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Players on this computer (Local Session only) -->
                    <views:LocalPlayersCard Visibility="{x:Bind LocalPlayers.SectionVisibility, Mode=OneWay}"
                                            ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

                    <!-- Owner's Displays -->
                    <views:DisplaysCard Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}"
                                        ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

                    <!-- Server (desktop app only) -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ServerSectionVisibility}">
                        <TextBlock Text="Server" Style="{StaticResource CantusSectionLabelStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{x:Bind ServerText}" FontSize="12" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ServerText}" />
                            <Button Grid.Column="1"
                                    Content="Change"
                                    Click="OnChangeServerClicked"
                                    Background="#1AFFFFFF"
                                    Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    FontSize="11"
                                    ToolTipService.ToolTip="Connect to another Cantus server" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Compact / Mobile Horizontal Now Playing Strip -->
            <Grid Visibility="{x:Bind GetMobileStripVisibility(Layout.CurrentBreakpoint), Mode=OneWay}"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="12">
                <!-- Art and track details open the Track tab, like a music app's mini player.
                     The transport buttons sit outside this button, so their taps never switch tabs.
                     A tap does not take focus: the strip collapses on the switch, and focus falling
                     back to the header would pop up that button's tooltip. -->
                <Button Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Click="OnOpenPlayerClicked"
                        AllowFocusOnInteraction="False"
                        PointerEntered="OnOpenPlayerPointerEntered"
                        PointerExited="OnOpenPlayerPointerExited"
                        PointerCanceled="OnOpenPlayerPointerExited"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="10"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="Open the player"
                        ToolTipService.ToolTip="Open the player">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <!-- Mini Album Art -->
                        <Border Grid.Column="0"
                                CornerRadius="10"
                                Width="56"
                                Height="56"
                                Background="#1A1B26"
                                BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                                BorderThickness="1">
                            <Grid>
                                <views:CantusIcon Kind="MusicNote" Size="22" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{x:Bind ViewModel.AlbumArtUrl, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.Name="Album art" />
                            </Grid>
                        </Border>

                        <!-- Track Details + Progress -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}"
                                       FontSize="15"
                                       FontFamily="{StaticResource CantusDisplaySemiBoldFontFamily}"
                                       Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                                         Minimum="0"
                                         Maximum="1"
                                         Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                                         Background="#1AFFFFFF"
                                         Height="3"
                                         CornerRadius="2" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Timestamps & Offset Tag -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Spacing="2"
                            Visibility="{x:Bind GetNarrowPhoneHiddenVisibility(Layout.IsNarrowPhone), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="11" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind Timing.OffsetText, Mode=OneWay}" FontSize="10" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" HorizontalAlignment="Right" />
                </StackPanel>

                <!-- Compact Transport Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.PlayerControlsVisibility, Mode=OneWay}">
                    <Button Click="OnSkipPreviousClicked"
                            Background="#20FFFFFF"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="16"
                            Width="32"
                            Height="32"
                            Padding="0">
                        <views:CantusIcon Kind="SkipBack" Size="13" />
                    </Button>
                    <Button Click="OnTogglePlayPauseClicked"
                            Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                            Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                            CornerRadius="18"
                            Width="36"
                            Height="36"
                            Padding="0">
                        <views:CantusIcon Kind="{x:Bind Transport.PlayPauseIcon, Mode=OneWay}" Size="15" />
                    </Button>
                    <Button Click="OnSkipNextClicked"
                            Background="#20FFFFFF"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="16"
                            Width="32"
                            Height="32"
                            Padding="0">
                        <views:CantusIcon Kind="SkipForward" Size="13" />
                    </Button>
                </StackPanel>

                <!-- Transport Command Feedback -->
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="4"
                           Text="{x:Bind Transport.TransportStatusText, Mode=OneWay}"
                           Visibility="{x:Bind Transport.TransportStatusVisibility, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
