<UserControl x:Class="Cantus.Client.Views.AdaptiveTrackCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cantus.Client"
             xmlns:views="using:Cantus.Client.Views"
             xmlns:services="using:Cantus.Client.Services"
             xmlns:vm="using:Cantus.Client.ViewModels"
             xmlns:models="using:Cantus.Client.Models">

    <Border Background="{x:Bind Theme.SurfaceCardBrush, Mode=OneWay}"
            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="{x:Bind GetCardPadding(Layout.CurrentBreakpoint), Mode=OneWay}">
        <Grid>
            <!-- Standard / Desktop / Tablet Card Layout -->
            <ScrollViewer x:Name="StandardCardScroller"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="OnStandardCardScrollerSizeChanged"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{x:Bind GetStandardCardVisibility(Layout.CurrentBreakpoint), Mode=OneWay}">
                <StackPanel Spacing="{x:Bind GetCardSpacing(Layout.CurrentBreakpoint), Mode=OneWay}">
                    
                    <!-- Album Art: shrinks to the card's content width (minus any scrollbar gutter);
                         the height is kept square from code-behind (SquareArtSizing) -->
                    <Border x:Name="AlbumArtFrame"
                            CornerRadius="16"
                            MaxWidth="{x:Bind Layout.AlbumArtSize, Mode=OneWay}"
                            Background="#1A1B26"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            SizeChanged="OnAlbumArtFrameSizeChanged">
                        <Grid>
                            <views:CantusIcon Kind="MusicNote"
                                              Size="{x:Bind GetAlbumIconSize(Layout.CurrentBreakpoint), Mode=OneWay}"
                                              Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <Image Source="{x:Bind ViewModel.AlbumArtUrl, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- Track Title & Artist -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}"
                                   FontSize="{x:Bind GetTitleFontSize(Layout.CurrentBreakpoint), Mode=OneWay}"
                                   FontFamily="{StaticResource CantusDisplaySemiBoldFontFamily}"
                                   Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}"
                                   FontSize="{x:Bind GetArtistFontSize(Layout.CurrentBreakpoint), Mode=OneWay}"
                                   FontFamily="{StaticResource CantusTextMediumFontFamily}"
                                   Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentAlbum, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Progress Bar & Timestamps (click to seek; hover shows a scrub thumb) -->
                    <StackPanel Spacing="6">
                        <Grid Background="Transparent"
                              MinHeight="18"
                              IsHitTestVisible="{x:Bind Pairing.CanControlPlayback, Mode=OneWay}"
                              PointerReleased="OnProgressBarPointerReleased"
                              PointerEntered="OnSeekBarPointerEntered"
                              PointerMoved="OnSeekBarPointerMoved"
                              PointerExited="OnSeekBarPointerExited"
                              ToolTipService.ToolTip="Seek">
                            <ProgressBar x:Name="SeekProgressBar"
                                         Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                                         Minimum="0"
                                         Maximum="1"
                                         Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                                         Background="#1AFFFFFF"
                                         Height="6"
                                         CornerRadius="3"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False" />
                            <Ellipse x:Name="SeekHoverThumb"
                                     Width="12"
                                     Height="12"
                                     Fill="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                                     Visibility="Collapsed"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="SeekHoverThumbTransform" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalDurationText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Playback Transport Controls -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" HorizontalAlignment="Center" Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}">
                        <Button Grid.Column="0"
                                Click="OnShuffleClicked"
                                Background="Transparent"
                                Foreground="{x:Bind Transport.ShuffleButtonForeground, Mode=OneWay}"
                                CornerRadius="16"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Shuffle">
                            <views:CantusIcon Kind="Shuffle" Size="16" />
                        </Button>
                        <Button Grid.Column="1"
                                Click="OnSkipPreviousClicked"
                                Background="#20FFFFFF"
                                Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                                CornerRadius="20"
                                Width="40"
                                Height="40"
                                Padding="0"
                                ToolTipService.ToolTip="Previous track">
                            <views:CantusIcon Kind="SkipBack" Size="16" />
                        </Button>
                        <Button Grid.Column="2"
                                Click="OnTogglePlayPauseClicked"
                                Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                                Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                                CornerRadius="24"
                                Width="48"
                                Height="48"
                                Padding="0"
                                ToolTipService.ToolTip="Play / Pause">
                            <views:CantusIcon Kind="{x:Bind Transport.PlayPauseIcon, Mode=OneWay}" Size="20" />
                        </Button>
                        <Button Grid.Column="3"
                                Click="OnSkipNextClicked"
                                Background="#20FFFFFF"
                                Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                                CornerRadius="20"
                                Width="40"
                                Height="40"
                                Padding="0"
                                ToolTipService.ToolTip="Next track">
                            <views:CantusIcon Kind="SkipForward" Size="16" />
                        </Button>
                        <Button Grid.Column="4"
                                Click="OnRepeatClicked"
                                Background="Transparent"
                                Foreground="{x:Bind Transport.RepeatButtonForeground, Mode=OneWay}"
                                CornerRadius="16"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Repeat">
                            <views:CantusIcon Kind="{x:Bind Transport.RepeatIcon, Mode=OneWay}" Size="16" />
                        </Button>
                    </Grid>

                    <!-- Volume -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}">
                        <views:CantusIcon Grid.Column="0"
                                          Kind="Volume"
                                          Size="16"
                                          Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                Value="{x:Bind Transport.VolumeSliderValue, Mode=OneWay}"
                                ValueChanged="OnVolumeSliderChanged"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Volume" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Transport.VolumeText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   VerticalAlignment="Center"
                                   MinWidth="34"
                                   TextAlignment="Right" />
                    </Grid>

                    <!-- Transport Command Feedback -->
                    <TextBlock Text="{x:Bind Transport.TransportStatusText, Mode=OneWay}"
                               Visibility="{x:Bind Transport.TransportStatusVisibility, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />

                    <!-- Instrumental Break Indicator -->
                    <Border Background="{x:Bind Theme.GlowBrush, Mode=OneWay}"
                            BorderBrush="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Visibility="{x:Bind GetInstrumentalVisibility(ViewModel.IsInstrumentalBreak), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <views:CantusIcon Kind="MusicNote" Size="16" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.InstrumentalBreakText, Mode=OneWay}" FontSize="13" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Device & Playback State -->
                    <Border Background="#15FFFFFF" BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <views:CantusIcon Grid.Column="0" Kind="Display" Size="16" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind GetPlaybackStatus(Transport.IsPlaying), Mode=OneWay}" FontSize="13" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <!-- Manual Sync Offset Adjuster -->
                    <Border Background="#15FFFFFF" BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Padding="14,10" Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Sync offset" VerticalAlignment="Center" Style="{StaticResource CantusSectionLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Timing.OffsetText, Mode=OneWay}" FontSize="12" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                                <Button Grid.Column="0" Content="-0.5s" Click="OnNudgeMinus500Clicked" Background="#20FFFFFF" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                                <Button Grid.Column="1" Content="-0.1s" Click="OnNudgeMinus100Clicked" Background="#20FFFFFF" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                                <Button Grid.Column="2" Content="Reset" Click="OnResetOffsetClicked" Background="#20FFFFFF" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                                <Button Grid.Column="3" Content="+0.1s" Click="OnNudgePlus100Clicked" Background="#20FFFFFF" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                                <Button Grid.Column="4" Content="+0.5s" Click="OnNudgePlus500Clicked" Background="#20FFFFFF" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Paired Display Card -->
                    <StackPanel Spacing="8" Visibility="{x:Bind Pairing.DisplayInfoVisibility, Mode=OneWay}">
                        <TextBlock Text="Display" Style="{StaticResource CantusSectionLabelStyle}" />
                        <Border Background="#15FFFFFF" BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <views:CantusIcon Kind="Display" Size="17" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Pairing.DisplayName, Mode=OneWay}" FontSize="13" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Paired display (view only)" FontSize="11" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Wrong Lyrics Picker (owner only) -->
                    <Button Click="OnWrongLyricsClicked"
                            Visibility="{x:Bind GetLyricsPickerVisibility(Pairing.OwnerControlsVisibility, LyricsPicker.ActionVisibility), Mode=OneWay}"
                            HorizontalAlignment="Stretch"
                            Background="#15FFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="10"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <views:CantusIcon Kind="Edit" Size="15" />
                            <TextBlock Text="Wrong lyrics?" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- Connected Spotify Account Card -->
                    <StackPanel Spacing="8" Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}">
                        <TextBlock Text="Spotify account" Style="{StaticResource CantusSectionLabelStyle}" />
                        
                        <!-- Logged in state -->
                        <Border Background="#15FFFFFF"
                                BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10"
                                Visibility="{x:Bind Session.HasSessionsVisibility, Mode=OneWay}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#20FFFFFF" Margin="0,0,10,0">
                                    <views:CantusIcon Kind="Account" Size="17" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Session.ActiveUserName, Mode=OneWay}" FontSize="13" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                                        <TextBlock Text="Active Account" FontSize="11" Foreground="#10B981" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Click="OnLogoutClicked"
                                        Background="#1AFFFFFF"
                                        Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        ToolTipService.ToolTip="Log Out">
                                    <views:CantusIcon Kind="SignOut" Size="14" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Not logged in state -->
                        <Border Background="#15FFFFFF"
                                BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10"
                                Visibility="{x:Bind Session.NoSessionsVisibility, Mode=OneWay}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Not Connected" FontSize="13" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" />
                                    <TextBlock Text="Log in to view lyrics" FontSize="11" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Click="OnPairAsDisplayClicked"
                                        HorizontalAlignment="Stretch"
                                        Background="#1AFFFFFF"
                                        BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                                        BorderThickness="1"
                                        Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                                        CornerRadius="6"
                                        Padding="10,5"
                                        ToolTipService.ToolTip="Show a code an owner approves from a signed-in device">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <views:CantusIcon Kind="Display" Size="13" />
                                        <TextBlock Text="Pair as display" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Click="OnConnectSpotifyClicked"
                                        Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                                        Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                                        CornerRadius="6"
                                        Padding="10,5"
                                        FontFamily="{StaticResource CantusTextSemiBoldFontFamily}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <views:CantusIcon Kind="SpotifyConnect" Size="13" />
                                        <TextBlock Text="Connect" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Owner's Displays -->
                    <views:DisplaysCard Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}"
                                        ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Compact / Mobile Horizontal Now Playing Strip -->
            <Grid Visibility="{x:Bind GetMobileStripVisibility(Layout.CurrentBreakpoint), Mode=OneWay}"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="12">
                <!-- Mini Album Art -->
                <Border Grid.Column="0"
                        CornerRadius="10"
                        Width="56"
                        Height="56"
                        Background="#1A1B26"
                        BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                        BorderThickness="1">
                    <Grid>
                        <views:CantusIcon Kind="MusicNote" Size="22" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{x:Bind ViewModel.AlbumArtUrl, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <!-- Track Details + Progress -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}"
                               FontSize="15"
                               FontFamily="{StaticResource CantusDisplaySemiBoldFontFamily}"
                               Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                                 Minimum="0"
                                 Maximum="1"
                                 Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                                 Background="#1AFFFFFF"
                                 Height="3"
                                 CornerRadius="2" />
                </StackPanel>

                <!-- Timestamps & Offset Tag -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Spacing="2"
                            Visibility="{x:Bind GetNarrowPhoneHiddenVisibility(Layout.IsNarrowPhone), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="11" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind Timing.OffsetText, Mode=OneWay}" FontSize="10" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" HorizontalAlignment="Right" />
                </StackPanel>

                <!-- Compact Transport Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}">
                    <Button Click="OnSkipPreviousClicked"
                            Background="#20FFFFFF"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="16"
                            Width="32"
                            Height="32"
                            Padding="0">
                        <views:CantusIcon Kind="SkipBack" Size="13" />
                    </Button>
                    <Button Click="OnTogglePlayPauseClicked"
                            Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                            Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                            CornerRadius="18"
                            Width="36"
                            Height="36"
                            Padding="0">
                        <views:CantusIcon Kind="{x:Bind Transport.PlayPauseIcon, Mode=OneWay}" Size="15" />
                    </Button>
                    <Button Click="OnSkipNextClicked"
                            Background="#20FFFFFF"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="16"
                            Width="32"
                            Height="32"
                            Padding="0">
                        <views:CantusIcon Kind="SkipForward" Size="13" />
                    </Button>
                </StackPanel>

                <!-- Transport Command Feedback -->
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="4"
                           Text="{x:Bind Transport.TransportStatusText, Mode=OneWay}"
                           Visibility="{x:Bind Transport.TransportStatusVisibility, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
