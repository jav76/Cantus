<UserControl x:Class="Cantus.Client.Views.NowPlayingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Cantus.Client.Views">

    <!-- The player: art, track text, seek bar, transport, volume and playback state.
         Hosts give it a card and, when it can scroll, its ScrollViewer (Scroller) for square art sizing. -->
    <StackPanel x:Name="PanelRoot"
                Spacing="{x:Bind GetSectionSpacing(Layout.CurrentBreakpoint), Mode=OneWay}"
                SizeChanged="OnPanelRootSizeChanged">
        <!-- Album Art: shrinks to the card's content width (minus any scrollbar gutter), and with
             FitArtToHeight also to the height the rest of the panel leaves free;
             the height is kept square from code-behind (SquareArtSizing) -->
        <Border x:Name="AlbumArtFrame"
                CornerRadius="16"
                MaxWidth="{x:Bind GetArtMaxWidth(Layout.AlbumArtSize, ArtHeightCap), Mode=OneWay}"
                Background="#1A1B26"
                BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                SizeChanged="OnAlbumArtFrameSizeChanged">
            <Grid>
                <views:CantusIcon Kind="MusicNote"
                                  Size="{x:Bind GetAlbumIconSize(Layout.CurrentBreakpoint), Mode=OneWay}"
                                  Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                <Image Source="{x:Bind ViewModel.AlbumArtUrl, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.Name="Album art" />
            </Grid>
        </Border>

        <!-- Track Title & Artist -->
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}"
                       FontSize="{x:Bind GetTitleFontSize(Layout.CurrentBreakpoint), Mode=OneWay}"
                       FontFamily="{StaticResource CantusDisplaySemiBoldFontFamily}"
                       Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                       TextAlignment="{x:Bind TrackTextAlignment, Mode=OneWay}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}"
                       FontSize="{x:Bind GetArtistFontSize(Layout.CurrentBreakpoint), Mode=OneWay}"
                       FontFamily="{StaticResource CantusTextMediumFontFamily}"
                       Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                       TextAlignment="{x:Bind TrackTextAlignment, Mode=OneWay}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.CurrentAlbum, Mode=OneWay}"
                       FontSize="13"
                       Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                       TextAlignment="{x:Bind TrackTextAlignment, Mode=OneWay}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Progress Bar & Timestamps (click to seek; hover shows a scrub thumb and holds the VU meter still) -->
        <StackPanel Spacing="6">
            <Grid x:Name="SeekArea"
                  Background="Transparent"
                  MinHeight="36"
                  IsHitTestVisible="{x:Bind ViewModel.CanUsePlayerControls, Mode=OneWay}"
                  PointerReleased="OnProgressBarPointerReleased"
                  PointerEntered="OnSeekBarPointerEntered"
                  PointerMoved="OnSeekBarPointerMoved"
                  PointerExited="OnSeekBarPointerExited"
                  PointerCanceled="OnSeekBarPointerExited"
                  ToolTipService.ToolTip="Seek">
                <views:VuMeterBars Meter="{x:Bind ViewModel.VuMeter, Mode=OneWay}"
                                   Progress="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                                   BarBrush="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                                   Height="36"
                                   Opacity="0.85"
                                   VerticalAlignment="Center" />
                <ProgressBar x:Name="SeekProgressBar"
                             Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                             Minimum="0"
                             Maximum="1"
                             Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                             Background="#1AFFFFFF"
                             Height="6"
                             CornerRadius="3"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False" />
                <Ellipse x:Name="SeekHoverThumb"
                         Width="12"
                         Height="12"
                         Fill="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                         Visibility="Collapsed"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SeekHoverThumbTransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <Grid ColumnDefinitions="*,*">
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalDurationText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>

        <!-- Playback Transport Controls -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.PlayerControlsVisibility, Mode=OneWay}">
            <Button Grid.Column="0"
                    Click="OnShuffleClicked"
                    Visibility="{x:Bind Session.SpotifyControlsVisibility, Mode=OneWay}"
                    Background="Transparent"
                    Foreground="{x:Bind Transport.ShuffleButtonForeground, Mode=OneWay}"
                    CornerRadius="16"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Shuffle">
                <views:CantusIcon Kind="Shuffle" Size="16" />
            </Button>
            <Button Grid.Column="1"
                    Click="OnSkipPreviousClicked"
                    Background="#20FFFFFF"
                    Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                    CornerRadius="20"
                    Width="40"
                    Height="40"
                    Padding="0"
                    ToolTipService.ToolTip="Previous track">
                <views:CantusIcon Kind="SkipBack" Size="16" />
            </Button>
            <Button Grid.Column="2"
                    Click="OnTogglePlayPauseClicked"
                    Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                    Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                    CornerRadius="24"
                    Width="48"
                    Height="48"
                    Padding="0"
                    ToolTipService.ToolTip="Play / Pause">
                <views:CantusIcon Kind="{x:Bind Transport.PlayPauseIcon, Mode=OneWay}" Size="20" />
            </Button>
            <Button Grid.Column="3"
                    Click="OnSkipNextClicked"
                    Background="#20FFFFFF"
                    Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                    CornerRadius="20"
                    Width="40"
                    Height="40"
                    Padding="0"
                    ToolTipService.ToolTip="Next track">
                <views:CantusIcon Kind="SkipForward" Size="16" />
            </Button>
            <Button Grid.Column="4"
                    Click="OnRepeatClicked"
                    Visibility="{x:Bind Session.SpotifyControlsVisibility, Mode=OneWay}"
                    Background="Transparent"
                    Foreground="{x:Bind Transport.RepeatButtonForeground, Mode=OneWay}"
                    CornerRadius="16"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Repeat">
                <views:CantusIcon Kind="{x:Bind Transport.RepeatIcon, Mode=OneWay}" Size="16" />
            </Button>
        </Grid>

        <!-- Volume (Spotify Sessions only) -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Visibility="{x:Bind GetSpotifyControlsVisibility(Pairing.OwnerControlsVisibility, Session.SpotifyControlsVisibility), Mode=OneWay}">
            <views:CantusIcon Grid.Column="0"
                              Kind="Volume"
                              Size="16"
                              Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                              VerticalAlignment="Center" />
            <Slider Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="1"
                    Value="{x:Bind Transport.VolumeSliderValue, Mode=OneWay}"
                    ValueChanged="OnVolumeSliderChanged"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Volume" />
            <TextBlock Grid.Column="2"
                       Text="{x:Bind Transport.VolumeText, Mode=OneWay}"
                       FontSize="12"
                       Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                       FontFamily="{StaticResource MonoFontFamily}"
                       VerticalAlignment="Center"
                       MinWidth="34"
                       TextAlignment="Right" />
        </Grid>

        <!-- Transport Command Feedback -->
        <TextBlock Text="{x:Bind Transport.TransportStatusText, Mode=OneWay}"
                   Visibility="{x:Bind Transport.TransportStatusVisibility, Mode=OneWay}"
                   FontSize="12"
                   Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />

        <!-- Instrumental Break Indicator -->
        <Border Background="{x:Bind Theme.GlowBrush, Mode=OneWay}"
                BorderBrush="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Visibility="{x:Bind GetInstrumentalVisibility(ViewModel.IsInstrumentalBreak), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <views:CantusIcon Kind="MusicNote" Size="16" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.InstrumentalBreakText, Mode=OneWay}" FontSize="13" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Device & Playback State -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <views:CantusIcon Grid.Column="0" Kind="Display" Size="16" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}"
                       FontSize="13"
                       Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind GetPlaybackStatus(Transport.IsPlaying), Mode=OneWay}" FontSize="13" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" />
        </Grid>
    </StackPanel>
</UserControl>
