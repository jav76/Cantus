<ContentDialog x:Class="Cantus.Client.Views.ServerSettingsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Cantus server"
               TitleTemplate="{StaticResource CantusDialogTitleTemplate}"
               PrimaryButtonText="{x:Bind Setup.SaveButtonText, Mode=OneWay}"
               CloseButtonText="Cancel"
               DefaultButton="Primary"
               IsPrimaryButtonEnabled="{x:Bind Setup.CanSave, Mode=OneWay}"
               PrimaryButtonClick="OnSaveClicked"
               Background="{x:Bind Theme.BackgroundBrush, Mode=OneWay}"
               Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
               CornerRadius="16">

    <StackPanel Spacing="12" MinWidth="280" MaxWidth="440" Margin="0,8,0,0">

        <TextBlock Text="The address of the Cantus server this app connects to. It is the address you open Cantus at in a browser."
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" />

        <StackPanel Spacing="4">
            <TextBlock Text="Server address" Style="{StaticResource CantusSectionLabelStyle}" />
            <TextBox x:Name="AddressBox"
                     MaxLength="2048"
                     FontSize="14"
                     IsSpellCheckEnabled="False"
                     IsEnabled="{x:Bind Setup.IsEditable}"
                     PlaceholderText="http://192.168.0.10:5000"
                     PlaceholderForeground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                     AutomationProperties.Name="Server address"
                     Background="{x:Bind Theme.SurfaceCardBrush, Mode=OneWay}"
                     Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                     Text="{x:Bind Setup.AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{x:Bind Setup.AddressError, Mode=OneWay}"
                       Visibility="{x:Bind Setup.AddressErrorVisibility, Mode=OneWay}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="#F87171" />
            <HyperlinkButton Content="Use the server on this computer"
                             Click="OnUseThisComputerClicked"
                             IsEnabled="{x:Bind Setup.IsEditable}"
                             Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                             FontSize="12"
                             Padding="0,2" />
        </StackPanel>

        <TextBlock Text="{x:Bind Setup.StatusText, Mode=OneWay}"
                   Visibility="{x:Bind Setup.StatusVisibility, Mode=OneWay}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{x:Bind GetStatusBrush(Setup.CheckState), Mode=OneWay}" />

        <TextBlock Text="{x:Bind Setup.LockedText}"
                   Visibility="{x:Bind Setup.LockedVisibility}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" />

        <StackPanel Spacing="6" Visibility="{x:Bind Setup.LocalServerVisibility}">
            <TextBlock Text="{x:Bind Setup.LocalServerText, Mode=OneWay}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" />
            <HyperlinkButton Content="Stop the server on this computer"
                             Click="OnStopLocalServerClicked"
                             IsEnabled="{x:Bind Setup.CanStopLocalServer, Mode=OneWay}"
                             Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                             FontSize="12"
                             Padding="0,2" />
        </StackPanel>

        <TextBlock Text="Cantus restarts to connect to the new server. This device is signed out, and if it is a paired Display it has to be paired again."
                   Visibility="{x:Bind Setup.ChangeWarningVisibility, Mode=OneWay}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
