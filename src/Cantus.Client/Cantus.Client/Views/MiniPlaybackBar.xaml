<UserControl x:Class="Cantus.Client.Views.MiniPlaybackBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cantus.Client"
             xmlns:vm="using:Cantus.Client.ViewModels"
             xmlns:models="using:Cantus.Client.Models">

    <Border Background="{x:Bind ViewModel.SurfaceCardBrush, Mode=OneWay}"
            BorderBrush="{x:Bind ViewModel.CardBorderBrush, Mode=OneWay}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20,12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <!-- Mini Track Info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border CornerRadius="8" Width="44" Height="44" Background="#1E1E2D">
                    <Image Source="{x:Bind ViewModel.AlbumArtUrl, Mode=OneWay}" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{x:Bind ViewModel.TextPrimaryBrush, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}" FontSize="13" Foreground="{x:Bind ViewModel.TextSecondaryBrush, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!-- Progress Bar & Text -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0">
                <ProgressBar Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                             Minimum="0"
                             Maximum="1"
                             Foreground="{x:Bind ViewModel.PrimaryAccentBrush, Mode=OneWay}"
                             Background="#1AFFFFFF"
                             Height="4"
                             CornerRadius="2" />
            </StackPanel>

            <!-- Timestamps -->
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="13" Foreground="{x:Bind ViewModel.TextMutedBrush, Mode=OneWay}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,16,0" />

            <!-- Exit Kiosk Button -->
            <Button Grid.Column="3"
                    Click="OnToggleKioskClicked"
                    Background="#22FFFFFF"
                    Foreground="{x:Bind ViewModel.TextPrimaryBrush, Mode=OneWay}"
                    CornerRadius="8"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE73F;" FontSize="14" />
                    <TextBlock Text="Exit Kiosk" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
