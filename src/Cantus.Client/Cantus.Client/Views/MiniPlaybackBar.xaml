<UserControl x:Class="Cantus.Client.Views.MiniPlaybackBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cantus.Client"
             xmlns:vm="using:Cantus.Client.ViewModels"
             xmlns:models="using:Cantus.Client.Models">

    <Border Background="{x:Bind Theme.SurfaceCardBrush, Mode=OneWay}"
            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20,12">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <!-- Mini Track Info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border CornerRadius="8" Width="44" Height="44" Background="#1E1E2D">
                    <Image Source="{x:Bind ViewModel.AlbumArtUrl, Mode=OneWay}" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}" FontSize="13" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!-- Progress Bar (click to seek; hover shows a scrub thumb) -->
            <Grid Grid.Column="1"
                  Background="Transparent"
                  MinHeight="18"
                  VerticalAlignment="Center"
                  Margin="32,0"
                  PointerReleased="OnProgressBarPointerReleased"
                  PointerEntered="OnSeekBarPointerEntered"
                  PointerMoved="OnSeekBarPointerMoved"
                  PointerExited="OnSeekBarPointerExited"
                  ToolTipService.ToolTip="Seek">
                <ProgressBar x:Name="SeekProgressBar"
                             Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                             Minimum="0"
                             Maximum="1"
                             Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                             Background="#1AFFFFFF"
                             Height="4"
                             CornerRadius="2"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False" />
                <Ellipse x:Name="SeekHoverThumb"
                         Width="12"
                         Height="12"
                         Fill="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                         Visibility="Collapsed"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SeekHoverThumbTransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Timestamps -->
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="13" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,16,0" />

            <!-- Transport Controls -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button Click="OnSkipPreviousClicked"
                        Background="#22FFFFFF"
                        Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                        CornerRadius="16"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Previous track">
                    <FontIcon Glyph="&#xE892;" FontSize="11" />
                </Button>
                <Button Click="OnTogglePlayPauseClicked"
                        Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                        Foreground="White"
                        CornerRadius="18"
                        Width="36"
                        Height="36"
                        Padding="0"
                        ToolTipService.ToolTip="Play / Pause">
                    <FontIcon Glyph="{x:Bind Transport.PlayPauseGlyph, Mode=OneWay}" FontSize="13" />
                </Button>
                <Button Click="OnSkipNextClicked"
                        Background="#22FFFFFF"
                        Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                        CornerRadius="16"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Next track">
                    <FontIcon Glyph="&#xE893;" FontSize="11" />
                </Button>
            </StackPanel>

            <!-- Exit Kiosk Button -->
            <Button Grid.Column="4"
                    Click="OnToggleKioskClicked"
                    Background="#22FFFFFF"
                    Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                    CornerRadius="8"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE73F;" FontSize="14" />
                    <TextBlock Text="Exit Kiosk" FontSize="12" />
                </StackPanel>
            </Button>

            <!-- Transport Command Feedback -->
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="5"
                       Text="{x:Bind Transport.TransportStatusText, Mode=OneWay}"
                       Visibility="{x:Bind Transport.TransportStatusVisibility, Mode=OneWay}"
                       FontSize="12"
                       Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
        </Grid>
    </Border>
</UserControl>
