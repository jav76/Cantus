<UserControl x:Class="Cantus.Client.Views.MiniPlaybackBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Cantus.Client.Views"
             xmlns:local="using:Cantus.Client"
             xmlns:vm="using:Cantus.Client.ViewModels"
             xmlns:models="using:Cantus.Client.Models">

    <Border Background="{x:Bind Theme.SurfaceCardBrush, Mode=OneWay}"
            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="{x:Bind GetBarPadding(Layout.IsKioskBarStacked), Mode=OneWay}">
        <!-- Track info and progress share the flexible width (2:3), so a long title is trimmed
             instead of pushing the transport and Exit Kiosk off screen. When stacked, the seek bar
             moves to row 1 (from code-behind) and the title takes all the flexible width -->
        <Grid RowDefinitions="Auto,Auto,Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition x:Name="ProgressColumn" Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Mini Album Art -->
            <Border Grid.Column="0" CornerRadius="8" Width="44" Height="44" Background="#1E1E2D" Margin="0,0,14,0" VerticalAlignment="Center"
                    Visibility="{x:Bind GetWideBarVisibility(Layout.IsKioskBarStacked), Mode=OneWay}">
                <Image Source="{x:Bind ViewModel.AlbumArtUrl, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>

            <!-- Mini Track Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" FontSize="17" FontFamily="{StaticResource CantusDisplaySemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}" FontSize="13" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Progress Bar (click to seek; hover shows a scrub thumb and holds the VU meter still) -->
            <Grid x:Name="SeekArea"
                  Grid.Column="2"
                  Background="Transparent"
                  MinHeight="28"
                  VerticalAlignment="Center"
                  Margin="{x:Bind GetProgressMargin(Layout.IsKioskBarCompact, Layout.IsKioskBarStacked), Mode=OneWay}"
                  IsHitTestVisible="{x:Bind ViewModel.CanUsePlayerControls, Mode=OneWay}"
                  PointerReleased="OnProgressBarPointerReleased"
                  PointerEntered="OnSeekBarPointerEntered"
                  PointerMoved="OnSeekBarPointerMoved"
                  PointerExited="OnSeekBarPointerExited"
                  PointerCanceled="OnSeekBarPointerExited"
                  ToolTipService.ToolTip="Seek">
                <views:VuMeterBars Meter="{x:Bind ViewModel.VuMeter, Mode=OneWay}"
                                   Progress="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                                   BarBrush="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                                   Height="28"
                                   Opacity="0.85"
                                   VerticalAlignment="Center" />
                <ProgressBar x:Name="SeekProgressBar"
                             Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                             Minimum="0"
                             Maximum="1"
                             Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                             Background="#1AFFFFFF"
                             Height="4"
                             CornerRadius="2"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False" />
                <Ellipse x:Name="SeekHoverThumb"
                         Width="12"
                         Height="12"
                         Fill="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                         Visibility="Collapsed"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SeekHoverThumbTransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Timestamps -->
            <TextBlock Grid.Column="3"
                       Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                       FontSize="13"
                       Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                       FontFamily="{StaticResource MonoFontFamily}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Visibility="{x:Bind GetWideBarVisibility(Layout.IsKioskBarCompact), Mode=OneWay}" />

            <!-- Transport Controls -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{x:Bind ViewModel.PlayerControlsVisibility, Mode=OneWay}">
                <Button Click="OnSkipPreviousClicked"
                        Background="#22FFFFFF"
                        Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                        CornerRadius="16"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Previous track">
                    <views:CantusIcon Kind="SkipBack" Size="13" />
                </Button>
                <Button Click="OnTogglePlayPauseClicked"
                        Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                        Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                        CornerRadius="18"
                        Width="36"
                        Height="36"
                        Padding="0"
                        ToolTipService.ToolTip="Play / Pause">
                    <views:CantusIcon Kind="{x:Bind Transport.PlayPauseIcon, Mode=OneWay}" Size="15" />
                </Button>
                <Button Click="OnSkipNextClicked"
                        Background="#22FFFFFF"
                        Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                        CornerRadius="16"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Next track">
                    <views:CantusIcon Kind="SkipForward" Size="13" />
                </Button>
            </StackPanel>

            <!-- Exit Kiosk Button -->
            <Button Grid.Column="5"
                    Click="OnToggleKioskClicked"
                    Background="#22FFFFFF"
                    Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                    CornerRadius="8"
                    Padding="12,6"
                    ToolTipService.ToolTip="Exit Kiosk (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <views:CantusIcon Kind="ExitFullScreen" Size="16" />
                    <TextBlock Text="Exit Kiosk" FontSize="12" Visibility="{x:Bind GetWideBarVisibility(Layout.IsKioskBarCompact), Mode=OneWay}" />
                </StackPanel>
            </Button>

            <!-- Transport Command Feedback -->
            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="6"
                       Text="{x:Bind Transport.TransportStatusText, Mode=OneWay}"
                       Visibility="{x:Bind Transport.TransportStatusVisibility, Mode=OneWay}"
                       FontSize="12"
                       Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
        </Grid>
    </Border>
</UserControl>
