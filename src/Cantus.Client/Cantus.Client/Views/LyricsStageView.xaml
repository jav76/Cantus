<UserControl x:Class="Cantus.Client.Views.LyricsStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cantus.Client"
             xmlns:views="using:Cantus.Client.Views"
             xmlns:vm="using:Cantus.Client.ViewModels"
             xmlns:models="using:Cantus.Client.Models">

    <Border Background="{x:Bind ViewModel.SurfaceCardBrush, Mode=OneWay}"
            BorderBrush="{x:Bind ViewModel.CardBorderBrush, Mode=OneWay}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="{x:Bind GetStagePadding(ViewModel.CurrentBreakpoint), Mode=OneWay}">
        <Grid RowDefinitions="Auto,*">
            
            <!-- Top Action Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <!-- Autoscroll Toggle Button -->
                    <Button Click="OnToggleAutoScrollClicked"
                            Background="{x:Bind GetAutoScrollButtonBackground(ViewModel.IsAutoScrollEnabled), Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5"
                            Visibility="{x:Bind ViewModel.AutoScrollToggleVisibility, Mode=OneWay}"
                            ToolTipService.ToolTip="Toggle dynamic centered lyrics scrolling (Autoscroll)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{x:Bind ViewModel.AutoScrollToggleGlyph, Mode=OneWay}" FontSize="12" Foreground="{x:Bind ViewModel.PrimaryAccentBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.AutoScrollToggleText, Mode=OneWay}" FontSize="11" Foreground="{x:Bind ViewModel.TextSecondaryBrush, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- Static Lyrics / Live Synced Toggle Button (Visible when synced lines exist) -->
                    <Button Click="OnToggleStaticModeClicked"
                            Background="#15FFFFFF"
                            BorderBrush="{x:Bind ViewModel.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5"
                            Visibility="{x:Bind ViewModel.ModeToggleVisibility, Mode=OneWay}"
                            ToolTipService.ToolTip="Toggle between Live Synced and Static Plain Lyrics">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{x:Bind ViewModel.ModeToggleGlyph, Mode=OneWay}" FontSize="12" Foreground="{x:Bind ViewModel.PrimaryAccentBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ModeToggleText, Mode=OneWay}" FontSize="11" Foreground="{x:Bind ViewModel.TextSecondaryBrush, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Lyrics Presentation Area -->
            <Grid Grid.Row="1" x:Name="LyricsPresentationContainer" SizeChanged="OnPresentationContainerSizeChanged">
                <!-- Empty / No Lyrics Placeholder -->
                <StackPanel Visibility="{x:Bind GetEmptyStateVisibility(ViewModel.HasLyrics), Mode=OneWay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <FontIcon Glyph="&#xEC4F;"
                              FontSize="{x:Bind GetEmptyIconSize(ViewModel.CurrentBreakpoint), Mode=OneWay}"
                              Foreground="{x:Bind ViewModel.TextMutedBrush, Mode=OneWay}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Waiting for Lyrics..."
                               FontSize="{x:Bind GetEmptyTitleSize(ViewModel.CurrentBreakpoint), Mode=OneWay}"
                               FontWeight="Bold"
                               Foreground="{x:Bind ViewModel.TextSecondaryBrush, Mode=OneWay}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Connect Spotify and play music to see lyrics."
                               FontSize="{x:Bind GetEmptySubtitleSize(ViewModel.CurrentBreakpoint), Mode=OneWay}"
                               Foreground="{x:Bind ViewModel.TextMutedBrush, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- Static Plain Lyrics View -->
                <ScrollViewer Visibility="{x:Bind ViewModel.StaticLyricsVisibility, Mode=OneWay}"
                              HorizontalAlignment="{x:Bind GetListHorizontalAlignment(ViewModel.CurrentBreakpoint), Mode=OneWay}"
                              MaxWidth="{x:Bind ViewModel.LyricsMaxWidth, Mode=OneWay}"
                              Padding="16,8">
                    <TextBlock Text="{x:Bind ViewModel.StaticLyricsText, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="Normal"
                               Foreground="{x:Bind ViewModel.TextPrimaryBrush, Mode=OneWay}"
                               LineHeight="32"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </ScrollViewer>

                <!-- Active Synced Lyrics Scroll Viewer -->
                <ScrollViewer x:Name="LyricsScrollViewer"
                              HorizontalAlignment="{x:Bind GetListHorizontalAlignment(ViewModel.CurrentBreakpoint), Mode=OneWay}"
                              MaxWidth="{x:Bind ViewModel.LyricsMaxWidth, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.SyncedLyricsVisibility, Mode=OneWay}"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              ViewChanged="OnScrollViewerViewChanged"
                              PointerWheelChanged="OnScrollViewerPointerWheelChanged"
                              PointerPressed="OnScrollViewerPointerPressed">
                    <ItemsControl x:Name="LyricsItemsControl"
                                  ItemsSource="{x:Bind ViewModel.LyricLines, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LyricLineViewModel">
                                <Border Background="Transparent"
                                        CornerRadius="10"
                                        Padding="8,6"
                                        Margin="0,4">
                                    <TextBlock Text="{x:Bind Text}"
                                               FontSize="{x:Bind FontSize, Mode=OneWay}"
                                               FontWeight="{x:Bind FontWeight, Mode=OneWay}"
                                               Opacity="{x:Bind Opacity, Mode=OneWay}"
                                               Foreground="{x:Bind LineBrush, Mode=OneWay}"
                                               Margin="0,4"
                                               TextAlignment="{x:Bind Alignment, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Floating Resume Autoscroll Button -->
                <Button x:Name="ResumeAutoScrollButton"
                        Click="OnResumeAutoScrollClicked"
                        Visibility="{x:Bind ViewModel.ResumeAutoScrollVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        Background="{x:Bind ViewModel.PrimaryAccentBrush, Mode=OneWay}"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="20"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="White" />
                        <TextBlock Text="Resume Autoscroll" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
