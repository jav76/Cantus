<UserControl x:Class="Cantus.Client.Views.MobileSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cantus.Client"
             xmlns:views="using:Cantus.Client.Views"
             xmlns:services="using:Cantus.Client.Services"
             xmlns:vm="using:Cantus.Client.ViewModels"
             xmlns:models="using:Cantus.Client.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="0,4">
            
            <!-- Manual Sync Offset Adjuster -->
            <Border Background="{x:Bind ViewModel.SurfaceCardBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.CardBorderBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,14">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="SYNC OFFSET" FontSize="11" FontWeight="Bold" Foreground="{x:Bind ViewModel.TextMutedBrush, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OffsetText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{x:Bind ViewModel.PrimaryAccentBrush, Mode=OneWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Content="-0.5s" Click="OnNudgeMinus500Clicked" Background="#20FFFFFF" Foreground="{x:Bind ViewModel.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                        <Button Grid.Column="1" Content="-0.1s" Click="OnNudgeMinus100Clicked" Background="#20FFFFFF" Foreground="{x:Bind ViewModel.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                        <Button Grid.Column="2" Content="Reset" Click="OnResetOffsetClicked" Background="#20FFFFFF" Foreground="{x:Bind ViewModel.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                        <Button Grid.Column="3" Content="+0.1s" Click="OnNudgePlus100Clicked" Background="#20FFFFFF" Foreground="{x:Bind ViewModel.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                        <Button Grid.Column="4" Content="+0.5s" Click="OnNudgePlus500Clicked" Background="#20FFFFFF" Foreground="{x:Bind ViewModel.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network Diagnostics Card -->
            <Border Background="{x:Bind ViewModel.SurfaceCardBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.CardBorderBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,14">
                <StackPanel Spacing="10">
                    <TextBlock Text="LIVE TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{x:Bind ViewModel.TextMutedBrush, Mode=OneWay}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Connection:" Foreground="{x:Bind ViewModel.TextMutedBrush, Mode=OneWay}" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" Foreground="#10B981" FontWeight="Bold" FontSize="12" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Latency RTT:" Foreground="{x:Bind ViewModel.TextMutedBrush, Mode=OneWay}" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind GetRttText(ViewModel.RttMs), Mode=OneWay}" Foreground="{x:Bind ViewModel.TextSecondaryBrush, Mode=OneWay}" FontSize="12" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Clock Skew:" Foreground="{x:Bind ViewModel.TextMutedBrush, Mode=OneWay}" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind GetSkewText(ViewModel.ClockSkewMs), Mode=OneWay}" Foreground="{x:Bind ViewModel.TextSecondaryBrush, Mode=OneWay}" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Theme Picker -->
            <Border Background="{x:Bind ViewModel.SurfaceCardBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.CardBorderBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="COLOR THEME" FontSize="11" FontWeight="Bold" Foreground="{x:Bind ViewModel.TextMutedBrush, Mode=OneWay}" />
                        <TextBlock Text="Custom Palette" FontSize="13" Foreground="{x:Bind ViewModel.TextPrimaryBrush, Mode=OneWay}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="OnCycleThemeClicked"
                            Background="#20FFFFFF"
                            Foreground="{x:Bind ViewModel.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE790;" FontSize="13" />
                            <TextBlock Text="Cycle Theme" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Authorized Accounts List -->
            <Border Background="{x:Bind ViewModel.SurfaceCardBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.CardBorderBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,14">
                <StackPanel Spacing="8">
                    <TextBlock Text="AUTHORIZED ACCOUNTS" FontSize="11" FontWeight="Bold" Foreground="{x:Bind ViewModel.TextMutedBrush, Mode=OneWay}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                              SelectionMode="None"
                              ItemClick="OnSessionItemClicked"
                              IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:AuthorizedSessionPayload">
                                <Border Background="#15FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,2">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="14" Foreground="#94A3B8" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                        <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#10B981" Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
