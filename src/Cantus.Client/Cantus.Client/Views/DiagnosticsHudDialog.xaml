<ContentDialog x:Class="Cantus.Client.Views.DiagnosticsHudDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:Cantus.Client.ViewModels"
               Title="Cantus Diagnostic Telemetry"
               PrimaryButtonText="Close"
               DefaultButton="Primary"
               Background="{x:Bind Theme.BackgroundBrush, Mode=OneWay}"
               Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
               CornerRadius="16">

    <StackPanel Spacing="16" MinWidth="420" Margin="0,12,0,0">
        
        <!-- SignalR Engine & Network -->
        <Border Background="#15FFFFFF" BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel Spacing="8">
                <TextBlock Text="SIGNALR &amp; NETWORK ENGINE" FontSize="11" FontWeight="Bold" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" Foreground="#10B981" FontWeight="Bold" FontSize="13" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Transport:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.TransportType, Mode=OneWay}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" FontSize="13" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="RTT / NTP Skew:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind GetLatencySkewText(ViewModel.RttMs, ViewModel.ClockSkewMs), Mode=OneWay}" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Latency Compensation:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Timing.CalibrationText, Mode=OneWay}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" FontSize="13" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Server Adaptive Poller -->
        <Border Background="#15FFFFFF" BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel Spacing="8">
                <TextBlock Text="SERVER POLLER &amp; SESSIONS" FontSize="11" FontWeight="Bold" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Poller Cadence:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind GetPollerCadenceText(ViewModel.PollerStatus, ViewModel.ActivePollIntervalMs), Mode=OneWay}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" FontSize="13" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Connected Clients:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ConnectedClients, Mode=OneWay}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" FontSize="13" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Authorized Accounts:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Session.AuthorizedSessionsCount, Mode=OneWay}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" FontSize="13" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Active Spotify Device -->
        <Border Background="#15FFFFFF" BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel Spacing="8">
                <TextBlock Text="SPOTIFY DEVICE &amp; STREAM" FontSize="11" FontWeight="Bold" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Active User:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Session.ActiveUserName, Mode=OneWay}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Device:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" FontSize="13" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Volume:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind GetVolumeText(Transport.VolumePercent), Mode=OneWay}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" FontSize="13" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Build & Runtime Info -->
        <Border Background="#15FFFFFF" BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel Spacing="8">
                <TextBlock Text="BUILD &amp; RUNTIME INFO" FontSize="11" FontWeight="Bold" Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="App Version:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" FontSize="13" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Commit SHA:" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" FontSize="13" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CommitSha, Mode=OneWay}" Foreground="{x:Bind Theme.SecondaryAccentBrush, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
