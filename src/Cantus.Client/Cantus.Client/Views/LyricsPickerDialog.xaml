<ContentDialog x:Class="Cantus.Client.Views.LyricsPickerDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:Cantus.Client.ViewModels"
               Title="Wrong lyrics?"
               CloseButtonText="Cancel"
               DefaultButton="Close"
               Background="{x:Bind Theme.BackgroundBrush, Mode=OneWay}"
               Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
               CornerRadius="16">

    <StackPanel Spacing="12" MaxWidth="520" Margin="0,8,0,0">
        <TextBlock Text="{x:Bind Picker.TrackText, Mode=OneWay}"
                   FontSize="13"
                   Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                   TextTrimming="CharacterEllipsis" />

        <!-- Override already in effect -->
        <Border Background="{x:Bind Theme.GlowBrush, Mode=OneWay}"
                BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10"
                Visibility="{x:Bind Picker.ClearOverrideVisibility, Mode=OneWay}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0"
                           Text="{x:Bind Picker.ActiveOverrideText, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Click="OnClearOverrideClicked"
                        IsEnabled="{x:Bind Picker.CanChoose, Mode=OneWay}"
                        Background="#20FFFFFF"
                        Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                        CornerRadius="6"
                        Padding="10,5"
                        FontSize="12"
                        Content="Use automatic lyrics" />
            </Grid>
        </Border>

        <!-- Loading -->
        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind Picker.LoadingVisibility, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind Picker.IsLoading, Mode=OneWay}" Width="18" Height="18" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" />
            <TextBlock Text="Searching the lyrics providers..." FontSize="13" Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{x:Bind Picker.StatusText, Mode=OneWay}"
                   Visibility="{x:Bind Picker.StatusVisibility, Mode=OneWay}"
                   FontSize="13"
                   Foreground="#FBBF24"
                   TextWrapping="Wrap" />

        <TextBlock Text="{x:Bind Picker.UnavailableText, Mode=OneWay}"
                   Visibility="{x:Bind Picker.UnavailableVisibility, Mode=OneWay}"
                   FontSize="12"
                   Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                   TextWrapping="Wrap" />

        <!-- Candidates -->
        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{x:Bind Picker.Candidates, Mode=OneWay}"
                          IsEnabled="{x:Bind Picker.CanChoose, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LyricsCandidateItem">
                        <Button Click="OnCandidateClicked"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="#15FFFFFF"
                                BorderBrush="{StaticResource CantusCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource CantusTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1"
                                            Background="#3310B981"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            Visibility="{x:Bind ActiveVisibility}">
                                        <TextBlock Text="In use" FontSize="11" Foreground="#10B981" />
                                    </Border>
                                    <Border Grid.Column="2" Background="#20FFFFFF" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="{x:Bind Provider}" FontSize="11" Foreground="{StaticResource CantusTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind DetailText}"
                                           FontSize="12"
                                           Foreground="{StaticResource CantusTextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind PreviewText}"
                                           Visibility="{x:Bind PreviewVisibility}"
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource CantusTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           MaxLines="2" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Choices that do not pick a candidate -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Click="OnRefetchClicked"
                    IsEnabled="{x:Bind Picker.CanChoose, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Background="#20FFFFFF"
                    Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                    CornerRadius="8"
                    Padding="8,8">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock Text="Re-fetch automatically" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1"
                    Click="OnNoLyricsClicked"
                    IsEnabled="{x:Bind Picker.CanChoose, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Background="#20FFFFFF"
                    Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                    CornerRadius="8"
                    Padding="8,8">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                    <TextBlock Text="No lyrics" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</ContentDialog>
