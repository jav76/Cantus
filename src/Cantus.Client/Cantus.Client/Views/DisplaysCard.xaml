<UserControl x:Class="Cantus.Client.Views.DisplaysCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Cantus.Client.Views"
             xmlns:vm="using:Cantus.Client.ViewModels">

    <!-- The signed-in owner's Displays: approve a new one, rename or remove each -->
    <StackPanel Spacing="8" Visibility="{x:Bind Displays.SectionVisibility, Mode=OneWay}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="0"
                       Text="Displays"
                       VerticalAlignment="Center"
                       Style="{StaticResource CantusSectionLabelStyle}" />
            <Button Grid.Column="1"
                    Click="OnRefreshClicked"
                    Background="#1AFFFFFF"
                    Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                    CornerRadius="6"
                    Padding="8,5"
                    ToolTipService.ToolTip="Refresh the list">
                <views:CantusIcon Kind="Refresh" Size="13" />
            </Button>
            <Button Grid.Column="2"
                    Click="OnApproveClicked"
                    Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                    Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                    CornerRadius="6"
                    Padding="10,5"
                    ToolTipService.ToolTip="Approve the code a screen shows">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <views:CantusIcon Kind="Add" Size="13" />
                    <TextBlock Text="Add display" FontSize="11" FontFamily="{StaticResource CantusTextSemiBoldFontFamily}" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Text="{x:Bind Displays.NoticeMessage, Mode=OneWay}"
                   Visibility="{x:Bind Displays.NoticeVisibility, Mode=OneWay}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#10B981" />

        <TextBlock Text="{x:Bind Displays.ListError, Mode=OneWay}"
                   Visibility="{x:Bind Displays.ListErrorVisibility, Mode=OneWay}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#F87171" />

        <TextBlock Text="Loading displays..."
                   Visibility="{x:Bind Displays.LoadingVisibility, Mode=OneWay}"
                   FontSize="11"
                   Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />

        <TextBlock Text="{x:Bind EmptyMessage}"
                   Visibility="{x:Bind Displays.EmptyVisibility, Mode=OneWay}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />

        <ItemsControl ItemsSource="{x:Bind Displays.Displays, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DisplayItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Padding="0,4">
                        <views:CantusIcon Grid.Column="0"
                                          Kind="Display"
                                          Size="18"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource CantusTextSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                       FontSize="13"
                                       FontFamily="{StaticResource CantusTextSemiBoldFontFamily}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource CantusTextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind LastSeenText, Mode=OneWay}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource CantusTextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Click="OnRenameClicked"
                                Background="#1AFFFFFF"
                                Foreground="{StaticResource CantusTextSecondaryBrush}"
                                CornerRadius="6"
                                Padding="8,6"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Rename">
                            <views:CantusIcon Kind="Rename" Size="14" />
                        </Button>
                        <Button Grid.Column="3"
                                Click="OnRevokeClicked"
                                Background="#1AFFFFFF"
                                Foreground="#F87171"
                                CornerRadius="6"
                                Padding="8,6"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Remove">
                            <views:CantusIcon Kind="Delete" Size="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
