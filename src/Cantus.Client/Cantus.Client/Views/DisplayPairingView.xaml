<UserControl x:Class="Cantus.Client.Views.DisplayPairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Cantus.Client.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="{x:Bind GetPagePadding(Layout.CurrentBreakpoint), Mode=OneWay}">
            <Border Background="{x:Bind Theme.SurfaceCardBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="{x:Bind GetCardPadding(Layout.CurrentBreakpoint), Mode=OneWay}"
                    MaxWidth="1200"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="20" HorizontalAlignment="Stretch">

                    <!-- Title -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="Pair this screen as a display"
                                   FontSize="{x:Bind GetTitleFontSize(Layout.CurrentBreakpoint), Mode=OneWay}"
                                   FontFamily="{StaticResource CantusDisplaySemiBoldFontFamily}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" />
                        <TextBlock Text="On a phone or computer signed in to Cantus, scan the QR code, or open the server address and enter the code."
                                   FontSize="15"
                                   MaxWidth="640"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Revoke, rejection and request failure notices -->
                    <Border Visibility="{x:Bind Pairing.StatusMessageVisibility, Mode=OneWay}"
                            Background="{x:Bind Theme.GlowBrush, Mode=OneWay}"
                            BorderBrush="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,10"
                            HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <views:CantusIcon Grid.Column="0" Kind="Info" Size="18" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Pairing.StatusMessage, Mode=OneWay}"
                                       FontSize="15"
                                       FontFamily="{StaticResource CantusTextSemiBoldFontFamily}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <!-- QR code and short code -->
                    <Grid Visibility="{x:Bind Pairing.CodeVisibility, Mode=OneWay}"
                          RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          RowSpacing="{x:Bind GetCodeRowSpacing(Layout.CurrentBreakpoint), Mode=OneWay}"
                          ColumnSpacing="{x:Bind GetCodeColumnSpacing(Layout.CurrentBreakpoint), Mode=OneWay}"
                          HorizontalAlignment="Center">
                        <Viewbox Grid.Row="0"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="{x:Bind GetCodeColumnSpan(Layout.CurrentBreakpoint), Mode=OneWay}"
                                 StretchDirection="DownOnly"
                                 MaxWidth="{x:Bind GetQrMaxSize(Layout.CurrentBreakpoint), Mode=OneWay}"
                                 VerticalAlignment="Center">
                            <Border Background="White" CornerRadius="12" Padding="4">
                                <Canvas x:Name="QrCanvas" />
                            </Border>
                        </Viewbox>

                        <StackPanel Grid.Row="{x:Bind GetCodeRow(Layout.CurrentBreakpoint), Mode=OneWay}"
                                    Grid.Column="{x:Bind GetCodeColumn(Layout.CurrentBreakpoint), Mode=OneWay}"
                                    Grid.ColumnSpan="{x:Bind GetCodeColumnSpan(Layout.CurrentBreakpoint), Mode=OneWay}"
                                    Spacing="12"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Code"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource CantusSectionLabelStyle}" />
                            <Viewbox StretchDirection="DownOnly" MaxWidth="640">
                                <TextBlock x:Name="CodeTextBlock"
                                           Text="{x:Bind Pairing.CodeText, Mode=OneWay}"
                                           FontSize="104"
                                           FontFamily="{StaticResource MonoBoldFontFamily}"
                                           CharacterSpacing="80"
                                           Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" />
                            </Viewbox>
                            <TextBlock Text="{x:Bind Pairing.ServerBaseUrl, Mode=OneWay}"
                                       FontSize="18"
                                       FontFamily="{StaticResource CantusTextSemiBoldFontFamily}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Pairing.ExpiresInText, Mode=OneWay}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- Waiting for the connection or a code -->
                    <StackPanel Visibility="{x:Bind Pairing.ProgressVisibility, Mode=OneWay}"
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center">
                        <ProgressRing IsActive="True" Width="24" Height="24" Foreground="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Pairing.PairingProgressText, Mode=OneWay}"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}" />
                    </StackPanel>

                    <Button Click="OnCancelClicked"
                            HorizontalAlignment="Center"
                            Background="#1AFFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="16,8">
                        <TextBlock Text="Cancel" FontSize="13" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
