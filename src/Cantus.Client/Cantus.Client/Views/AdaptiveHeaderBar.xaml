<UserControl x:Class="Cantus.Client.Views.AdaptiveHeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cantus.Client"
             xmlns:views="using:Cantus.Client.Views"
             xmlns:vm="using:Cantus.Client.ViewModels"
             xmlns:models="using:Cantus.Client.Models">

    <!-- No card: a bottom hairline separates the header from the content -->
    <Border BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
            BorderThickness="0,0,0,1"
            Padding="{x:Bind GetHeaderPadding(Layout.CurrentBreakpoint), Mode=OneWay}"
            Margin="0,0,0,16">
        <Grid>
            <!-- Large / Desktop Header Layout -->
            <Grid Visibility="{x:Bind GetLargeHeaderVisibility(Layout.CurrentBreakpoint), Mode=OneWay}"
                  ColumnDefinitions="Auto,*,Auto">
                
                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}">
                        <views:CantusIcon Kind="Brand" Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}" Size="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cantus" FontSize="20" FontFamily="{StaticResource CantusDisplaySemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" />
                        <TextBlock Text="Real-Time Synced Lyrics"
                                   FontSize="11"
                                   Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}"
                                   Visibility="{x:Bind GetLabelVisibility(Layout.ShowFullHeaderLabels), Mode=OneWay}" />
                    </StackPanel>
                    <!-- Connection status: details in the tooltip (set in code-behind), problems also get the alert chip -->
                    <Border x:Name="LargeStatusIndicator"
                            Background="Transparent"
                            Padding="4"
                            VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{x:Bind GetStatusColor(ViewModel.ConnectionStatus), Mode=OneWay}" />
                    </Border>
                </StackPanel>

                <!-- Alert chip: only while the connection is down or the poller is rate limited (set in code-behind) -->
                <Border x:Name="LargeAlertChip"
                        Grid.Column="1"
                        Margin="12,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Background="#15FFFFFF"
                        BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Ellipse x:Name="LargeAlertDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="LargeAlertText"
                                   Grid.Column="1"
                                   FontSize="12"
                                   Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Find a Song by Lyrics (signed-in owners only) -->
                    <Button Click="OnOpenSongLookupClicked"
                            Visibility="{x:Bind GetSongLookupVisibility(Pairing.OwnerControlsVisibility, Session.OwnerActionsVisibility), Mode=OneWay, FallbackValue=Collapsed}"
                            Background="#1AFFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="12,8"
                            ToolTipService.ToolTip="Find a song by lyrics">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:CantusIcon Kind="Search" Size="17" />
                            <TextBlock Text="Find Song" FontSize="12" Visibility="{x:Bind GetLabelVisibility(Layout.ShowFullHeaderLabels), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- Theme Dropdown (items built in code by ThemeMenuItems) -->
                    <Button Background="#1AFFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="8,8,6,8"
                            ToolTipService.ToolTip="Color theme and effects (T cycles themes)">
                        <Button.Flyout>
                            <MenuFlyout x:Name="LargeThemeMenu" Placement="BottomEdgeAlignedRight" Opening="OnThemeMenuOpening" />
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <views:CantusIcon Kind="Palette" Size="17" />
                            <TextBlock Text="Theme" FontSize="12" Visibility="{x:Bind GetLabelVisibility(Layout.ShowFullHeaderLabels), Mode=OneWay}" />
                            <views:CantusIcon Kind="ChevronDown" Size="11" />
                        </StackPanel>
                    </Button>

                    <!-- Diagnostics HUD -->
                    <Button Click="OnOpenDiagnosticsHudClicked"
                            Background="#1AFFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="10,8"
                            ToolTipService.ToolTip="Open Diagnostics HUD">
                        <views:CantusIcon Kind="Diagnostics" Size="17" />
                    </Button>

                    <!-- Fullscreen Kiosk Mode -->
                    <Button Click="OnToggleKioskClicked"
                            Background="#1AFFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="10,8"
                            ToolTipService.ToolTip="Enter Fullscreen Kiosk Mode (F11 / K)">
                        <views:CantusIcon Kind="EnterFullScreen" Size="17" />
                    </Button>

                    <!-- Spotify SSO -->
                    <Button Click="OnConnectSpotifyClicked"
                            Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}"
                            Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                            Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="14,8"
                            FontFamily="{StaticResource CantusTextSemiBoldFontFamily}"
                            ToolTipService.ToolTip="{x:Bind Session.ConnectButtonText, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <views:CantusIcon Kind="{x:Bind Session.ConnectButtonIcon, Mode=OneWay}" Size="18" />
                            <TextBlock Text="{x:Bind Session.ConnectButtonText, Mode=OneWay}"
                                       FontSize="13"
                                       MaxWidth="{x:Bind Layout.HeaderAccountNameMaxWidth, Mode=OneWay}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Medium / Tablet Header Layout -->
            <Grid Visibility="{x:Bind GetMediumHeaderVisibility(Layout.CurrentBreakpoint), Mode=OneWay}"
                  ColumnDefinitions="Auto,*,Auto">
                
                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}">
                        <views:CantusIcon Kind="Brand" Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Cantus" FontSize="18" FontFamily="{StaticResource CantusDisplaySemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" VerticalAlignment="Center" />
                    <!-- Connection status: details in the tooltip (set in code-behind), problems also get the alert chip -->
                    <Border x:Name="MediumStatusIndicator"
                            Background="Transparent"
                            Padding="4"
                            VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind GetStatusColor(ViewModel.ConnectionStatus), Mode=OneWay}" />
                    </Border>
                </StackPanel>

                <!-- Alert chip: only while the connection is down or the poller is rate limited (set in code-behind) -->
                <Border x:Name="MediumAlertChip"
                        Grid.Column="1"
                        Margin="12,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Background="#15FFFFFF"
                        BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,4">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Ellipse x:Name="MediumAlertDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="MediumAlertText"
                                   Grid.Column="1"
                                   FontSize="11"
                                   Foreground="{x:Bind Theme.TextSecondaryBrush, Mode=OneWay}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- Compact Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Click="OnOpenSongLookupClicked"
                            Visibility="{x:Bind GetSongLookupVisibility(Pairing.OwnerControlsVisibility, Session.OwnerActionsVisibility), Mode=OneWay, FallbackValue=Collapsed}"
                            Background="#1AFFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="8,6"
                            ToolTipService.ToolTip="Find a song by lyrics">
                        <views:CantusIcon Kind="Search" Size="16" />
                    </Button>

                    <!-- Padding is trimmed so the chevron keeps the button at its old width -->
                    <Button Background="#1AFFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="5,6,4,6"
                            ToolTipService.ToolTip="Theme and effects (T cycles themes)">
                        <Button.Flyout>
                            <MenuFlyout x:Name="MediumThemeMenu" Placement="BottomEdgeAlignedRight" Opening="OnThemeMenuOpening" />
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal">
                            <views:CantusIcon Kind="Palette" Size="16" />
                            <views:CantusIcon Kind="ChevronDown" Size="10" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Click="OnOpenDiagnosticsHudClicked"
                            Background="#1AFFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="8,6"
                            ToolTipService.ToolTip="Diagnostics">
                        <views:CantusIcon Kind="Diagnostics" Size="16" />
                    </Button>

                    <Button Click="OnToggleKioskClicked"
                            Background="#1AFFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="8,6"
                            ToolTipService.ToolTip="Fullscreen (F11)">
                        <views:CantusIcon Kind="EnterFullScreen" Size="16" />
                    </Button>

                    <Button Click="OnConnectSpotifyClicked"
                            Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}"
                            Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                            Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="10,6"
                            FontFamily="{StaticResource CantusTextSemiBoldFontFamily}"
                            ToolTipService.ToolTip="{x:Bind Session.ConnectButtonText, Mode=OneWay}">
                        <views:CantusIcon Kind="{x:Bind Session.ConnectButtonIcon, Mode=OneWay}" Size="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Small / Mobile Header Layout -->
            <Grid Visibility="{x:Bind GetSmallHeaderVisibility(Layout.CurrentBreakpoint), Mode=OneWay}"
                  ColumnDefinitions="Auto,*,Auto">
                
                <!-- Brand + Live Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}">
                        <views:CantusIcon Kind="Brand" Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Cantus" FontSize="17" FontFamily="{StaticResource CantusDisplaySemiBoldFontFamily}" Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}" VerticalAlignment="Center" />
                    <!-- Connection status: details in the tooltip (set in code-behind) -->
                    <Border x:Name="SmallStatusIndicator"
                            Background="Transparent"
                            Padding="4"
                            VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind GetStatusColor(ViewModel.ConnectionStatus), Mode=OneWay}" />
                    </Border>
                </StackPanel>

                <!-- Mobile Quick Actions / Overflow Menu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Spotify SSO Mini -->
                    <Button Click="OnConnectSpotifyClicked"
                            Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}"
                            Background="{x:Bind Theme.PrimaryAccentBrush, Mode=OneWay}"
                            Foreground="{x:Bind Theme.OnPrimaryAccentBrush, Mode=OneWay}"
                            CornerRadius="6"
                            Padding="8,5">
                        <views:CantusIcon Kind="{x:Bind Session.ConnectButtonIcon, Mode=OneWay}" Size="15" />
                    </Button>

                    <!-- Mobile Overflow Menu Button -->
                    <Button Background="#1AFFFFFF"
                            BorderBrush="{x:Bind Theme.CardBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            Foreground="{x:Bind Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="6"
                            Padding="8,5">
                        <Button.Flyout>
                            <MenuFlyout Opening="OnThemeMenuOpening">
                                <MenuFlyoutItem Text="Find Song by Lyrics"
                                                Click="OnOpenSongLookupClicked"
                                                Visibility="{x:Bind GetSongLookupVisibility(Pairing.OwnerControlsVisibility, Session.OwnerActionsVisibility), Mode=OneWay, FallbackValue=Collapsed}">
                                    <MenuFlyoutItem.Icon>
                                        <views:CantusIcon Kind="Search" Size="16" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSubItem x:Name="SmallThemeMenu" Text="Theme">
                                    <MenuFlyoutSubItem.Icon>
                                        <views:CantusIcon Kind="Palette" Size="16" />
                                    </MenuFlyoutSubItem.Icon>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem Text="Diagnostics HUD" Click="OnOpenDiagnosticsHudClicked">
                                    <MenuFlyoutItem.Icon>
                                        <views:CantusIcon Kind="Diagnostics" Size="16" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Fullscreen Kiosk (F11)" Click="OnToggleKioskClicked">
                                    <MenuFlyoutItem.Icon>
                                        <views:CantusIcon Kind="EnterFullScreen" Size="16" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Switch Mobile View" Click="OnCycleMobileViewClicked">
                                    <MenuFlyoutItem.Icon>
                                        <views:CantusIcon Kind="SwitchView" Size="16" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Log Out" Click="OnLogoutClicked" Visibility="{x:Bind Pairing.OwnerControlsVisibility, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <views:CantusIcon Kind="SignOut" Size="16" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <views:CantusIcon Kind="Menu" Size="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
