<UserControl x:Class="Cantus.Client.Views.LocalPlayersCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Cantus.Client.Views"
             xmlns:vm="using:Cantus.Client.ViewModels">

    <!-- Local Session only: each player app seen, its switch, and which one is followed -->
    <StackPanel Spacing="8" Visibility="{x:Bind Players.SectionVisibility, Mode=OneWay}">
        <TextBlock Text="Players on this computer" Style="{StaticResource CantusSectionLabelStyle}" />

        <TextBlock Text="{x:Bind Players.EmptyText}"
                   Visibility="{x:Bind Players.EmptyVisibility, Mode=OneWay}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />

        <ItemsControl ItemsSource="{x:Bind Players.Players, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalPlayerItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                  Foreground="{StaticResource CantusTextPrimaryBrush}"
                                  ToolTipService.ToolTip="Follow this player">
                            <TextBlock Text="{x:Bind AppName}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource CantusTextPrimaryBrush}" />
                        </CheckBox>
                        <TextBlock Grid.Column="1"
                                   Text="Following"
                                   Visibility="{x:Bind FollowedVisibility, Mode=OneWay}"
                                   FontSize="11"
                                   FontFamily="{StaticResource CantusTextSemiBoldFontFamily}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource CantusPrimaryAccentBrush}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Cantus follows the player that most recently started a song. Untick a player to ignore it."
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{x:Bind Theme.TextMutedBrush, Mode=OneWay}" />
    </StackPanel>
</UserControl>
