<Page x:Class="Cantus.Client.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Cantus.Client"
      xmlns:vm="using:Cantus.Client.ViewModels"
      xmlns:models="using:Cantus.Client.Models"
      Background="{x:Bind ViewModel.Theme.BackgroundBrush, Mode=OneWay}">

    <Grid>
        <!-- Dynamic Ambient Glow Layer -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.35">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{x:Bind ViewModel.Theme.ActivePalette.PrimaryAccent, Mode=OneWay}" Offset="0.0" />
                    <GradientStop Color="{x:Bind ViewModel.Theme.ActivePalette.Background, Mode=OneWay}" Offset="0.8" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Standard Presentation Layout -->
        <Grid RowDefinitions="Auto,*" Margin="24" Visibility="{x:Bind GetStandardViewVisibility(ViewModel.IsKioskMode), Mode=OneWay}">
            
            <!-- Top App Bar & Live Telemetry Diagnostics -->
            <Border Grid.Row="0"
                    Background="{x:Bind ViewModel.Theme.SurfaceCardBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,12"
                    Margin="0,0,0,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <!-- Brand Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{x:Bind ViewModel.Theme.PrimaryAccentBrush, Mode=OneWay}">
                            <FontIcon Glyph="&#xE767;" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cantus" FontSize="20" FontWeight="Bold" Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}" />
                            <TextBlock Text="Real-Time Synced Lyrics" FontSize="11" Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Diagnostics Telemetry Pills -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Connection Status -->
                        <Border Background="#15FFFFFF" BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{x:Bind GetStatusColor(ViewModel.ConnectionStatus), Mode=OneWay}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" FontSize="12" Foreground="{x:Bind ViewModel.Theme.TextSecondaryBrush, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <!-- Latency RTT -->
                        <Border Background="#15FFFFFF" BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="{x:Bind GetRttText(ViewModel.RttMs), Mode=OneWay}" FontSize="12" Foreground="{x:Bind ViewModel.Theme.TextSecondaryBrush, Mode=OneWay}" />
                        </Border>
                        <!-- NTP Skew -->
                        <Border Background="#15FFFFFF" BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="{x:Bind GetSkewText(ViewModel.ClockSkewMs), Mode=OneWay}" FontSize="12" Foreground="{x:Bind ViewModel.Theme.TextSecondaryBrush, Mode=OneWay}" />
                        </Border>
                        <!-- Poller Cadence -->
                        <Border Background="#15FFFFFF" BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="{x:Bind ViewModel.PollerStatus, Mode=OneWay}" FontSize="12" Foreground="{x:Bind ViewModel.Theme.TextSecondaryBrush, Mode=OneWay}" />
                        </Border>
                    </StackPanel>

                    <!-- Action Controls (Theme, Telemetry HUD, Kiosk, Spotify SSO) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Theme Switcher Button -->
                        <Button Click="OnCycleThemeClicked"
                                Background="#1AFFFFFF"
                                BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}"
                                BorderThickness="1"
                                Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}"
                                CornerRadius="8"
                                Padding="12,8"
                                ToolTipService.ToolTip="Cycle Color Theme (T)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE790;" FontSize="15" />
                                <TextBlock Text="{x:Bind ViewModel.Theme.ActivePalette.Name, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <!-- Diagnostics HUD Button -->
                        <Button Click="OnOpenDiagnosticsHudClicked"
                                Background="#1AFFFFFF"
                                BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}"
                                BorderThickness="1"
                                Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}"
                                CornerRadius="8"
                                Padding="10,8"
                                ToolTipService.ToolTip="Open Diagnostics HUD">
                            <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                        </Button>

                        <!-- Fullscreen Kiosk Mode Button -->
                        <Button Click="OnToggleKioskClicked"
                                Background="#1AFFFFFF"
                                BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}"
                                BorderThickness="1"
                                Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}"
                                CornerRadius="8"
                                Padding="10,8"
                                ToolTipService.ToolTip="Enter Fullscreen Kiosk Mode (F11 / K)">
                            <FontIcon Glyph="&#xE740;" FontSize="15" />
                        </Button>

                        <!-- Spotify SSO Button -->
                        <Button Click="OnConnectSpotifyClicked"
                                Background="{x:Bind ViewModel.Theme.PrimaryAccentBrush, Mode=OneWay}"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="14,8"
                                FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                                <TextBlock Text="Connect Spotify" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area: Left Track Card + Right Lyrics Stage -->
            <Grid Grid.Row="1" ColumnDefinitions="380,*" ColumnSpacing="24">
                
                <!-- Left Panel: Track Metadata & Controls Card -->
                <Border Grid.Column="0"
                        Background="{x:Bind ViewModel.Theme.SurfaceCardBrush, Mode=OneWay}"
                        BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            
                            <!-- Album Art -->
                            <Border CornerRadius="16"
                                    Width="332"
                                    Height="332"
                                    Background="#1A1B26"
                                    BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <FontIcon Glyph="&#xEC4F;" FontSize="64" Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{x:Bind ViewModel.AlbumArtUrl, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <!-- Track Title & Artist -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}"
                                           FontSize="15"
                                           FontWeight="Medium"
                                           Foreground="{x:Bind ViewModel.Theme.TextSecondaryBrush, Mode=OneWay}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentAlbum, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Progress Bar & Timestamps -->
                            <StackPanel Spacing="6">
                                <ProgressBar Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                                             Minimum="0"
                                             Maximum="1"
                                             Foreground="{x:Bind ViewModel.Theme.PrimaryAccentBrush, Mode=OneWay}"
                                             Background="#1AFFFFFF"
                                             Height="6"
                                             CornerRadius="3" />
                                <Grid ColumnDefinitions="*,*">
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalDurationText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}" FontFamily="Consolas" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <!-- Instrumental Break Indicator -->
                            <Border Background="{x:Bind ViewModel.Theme.GlowBrush, Mode=OneWay}"
                                    BorderBrush="{x:Bind ViewModel.Theme.PrimaryAccentBrush, Mode=OneWay}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,8"
                                    Visibility="{x:Bind GetInstrumentalVisibility(ViewModel.IsInstrumentalBreak), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xEC4F;" FontSize="14" Foreground="{x:Bind ViewModel.Theme.PrimaryAccentBrush, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.InstrumentalBreakText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Device & Playback State -->
                            <Border Background="#15FFFFFF" BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" FontSize="13" Foreground="{x:Bind ViewModel.Theme.TextSecondaryBrush, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind GetPlaybackStatus(ViewModel.IsPlaying), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.Theme.PrimaryAccentBrush, Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <!-- Manual Sync Offset Adjuster (Micro & Macro) -->
                            <Border Background="#15FFFFFF" BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="SYNC OFFSET" FontSize="11" FontWeight="Bold" Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OffsetText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{x:Bind ViewModel.Theme.PrimaryAccentBrush, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                                        <Button Grid.Column="0" Content="-0.5s" Click="OnNudgeMinus500Clicked" Background="#20FFFFFF" Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                                        <Button Grid.Column="1" Content="-0.1s" Click="OnNudgeMinus100Clicked" Background="#20FFFFFF" Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                                        <Button Grid.Column="2" Content="Reset" Click="OnResetOffsetClicked" Background="#20FFFFFF" Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                                        <Button Grid.Column="3" Content="+0.1s" Click="OnNudgePlus100Clicked" Background="#20FFFFFF" Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                                        <Button Grid.Column="4" Content="+0.5s" Click="OnNudgePlus500Clicked" Background="#20FFFFFF" Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Stretch" Padding="2,6" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Authorized Accounts List -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="AUTHORIZED ACCOUNTS" FontSize="11" FontWeight="Bold" Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}" />
                                <ListView ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                                          SelectionMode="None"
                                          ItemClick="OnSessionItemClicked"
                                          IsItemClickEnabled="True">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:Services.AuthorizedSessionPayload">
                                            <Border Background="#15FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,2">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="14" Foreground="#94A3B8" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                    <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#10B981" Visibility="{x:Bind local:MainPage.GetPlayingVisibility(IsCurrentlyPlaying)}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Panel: Live Synced Karaoke Lyrics Stage -->
                <Border Grid.Column="1"
                        Background="{x:Bind ViewModel.Theme.SurfaceCardBrush, Mode=OneWay}"
                        BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="32">
                    <Grid>
                        <!-- Empty / No Lyrics Placeholder -->
                        <StackPanel Visibility="{x:Bind GetEmptyStateVisibility(ViewModel.HasLyrics), Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                            <FontIcon Glyph="&#xEC4F;" FontSize="56" Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}" HorizontalAlignment="Center" />
                            <TextBlock Text="Waiting for Synced Lyrics..." FontSize="20" FontWeight="Bold" Foreground="{x:Bind ViewModel.Theme.TextSecondaryBrush, Mode=OneWay}" HorizontalAlignment="Center" />
                            <TextBlock Text="Connect Spotify and play music to see live time-synchronized lyrics." FontSize="14" Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Lyrics List View -->
                        <ListView x:Name="LyricsListView"
                                  ItemsSource="{x:Bind ViewModel.LyricLines, Mode=OneWay}"
                                  SelectionMode="None"
                                  Visibility="{x:Bind GetLyricsVisibility(ViewModel.HasLyrics), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:LyricLineViewModel">
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                               FontSize="{x:Bind FontSize, Mode=OneWay}"
                                               FontWeight="{x:Bind FontWeight, Mode=OneWay}"
                                               Opacity="{x:Bind Opacity, Mode=OneWay}"
                                               Foreground="{x:Bind local:MainPage.GetLineColor(IsActive, IsPast), Mode=OneWay}"
                                               Margin="0,12"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Fullscreen / 10-Foot Kiosk Presentation Mode -->
        <Grid Margin="48,32" RowDefinitions="*,Auto" Visibility="{x:Bind GetKioskViewVisibility(ViewModel.IsKioskMode), Mode=OneWay}">
            
            <!-- Center-Anchored Fullscreen Lyrics Stage -->
            <Grid Grid.Row="0">
                <ListView x:Name="KioskLyricsListView"
                          ItemsSource="{x:Bind ViewModel.LyricLines, Mode=OneWay}"
                          SelectionMode="None"
                          HorizontalAlignment="Center"
                          MaxWidth="1000"
                          Visibility="{x:Bind GetLyricsVisibility(ViewModel.HasLyrics), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LyricLineViewModel">
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                       FontSize="{x:Bind local:MainPage.GetKioskFontSize(IsActive), Mode=OneWay}"
                                       FontWeight="{x:Bind FontWeight, Mode=OneWay}"
                                       Opacity="{x:Bind Opacity, Mode=OneWay}"
                                       Foreground="{x:Bind local:MainPage.GetLineColor(IsActive, IsPast), Mode=OneWay}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,18"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Bottom Floating Minimal Telemetry Bar -->
            <Border Grid.Row="1"
                    Background="{x:Bind ViewModel.Theme.SurfaceCardBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.Theme.CardBorderBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,12"
                    Margin="0,20,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- Mini Track Info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border CornerRadius="8" Width="44" Height="44" Background="#1E1E2D">
                            <Image Source="{x:Bind ViewModel.AlbumArtUrl, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}" FontSize="13" Foreground="{x:Bind ViewModel.Theme.TextSecondaryBrush, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Progress Bar & Text -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0">
                        <ProgressBar Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                                     Minimum="0"
                                     Maximum="1"
                                     Foreground="{x:Bind ViewModel.Theme.PrimaryAccentBrush, Mode=OneWay}"
                                     Background="#1AFFFFFF"
                                     Height="4"
                                     CornerRadius="2" />
                    </StackPanel>

                    <!-- Timestamps -->
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="13" Foreground="{x:Bind ViewModel.Theme.TextMutedBrush, Mode=OneWay}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Exit Kiosk Button -->
                    <Button Grid.Column="3"
                            Click="OnToggleKioskClicked"
                            Background="#22FFFFFF"
                            Foreground="{x:Bind ViewModel.Theme.TextPrimaryBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73F;" FontSize="14" />
                            <TextBlock Text="Exit Kiosk" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
