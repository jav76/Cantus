<Page x:Class="Cantus.Client.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Cantus.Client"
      xmlns:views="using:Cantus.Client.Views"
      xmlns:vm="using:Cantus.Client.ViewModels"
      xmlns:models="using:Cantus.Client.Models"
      Background="{x:Bind ViewModel.BackgroundBrush, Mode=OneWay}"
      SizeChanged="OnPageSizeChanged">

    <Grid>
        <!-- Dynamic Ambient Glow Layer -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.35">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{x:Bind ViewModel.ActivePrimaryAccentColor, Mode=OneWay}" Offset="0.0" />
                    <GradientStop Color="{x:Bind ViewModel.ActiveBackgroundColor, Mode=OneWay}" Offset="0.8" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Responsive Content Container -->
        <Grid Padding="{x:Bind ViewModel.ContentPadding, Mode=OneWay}">
            
            <!-- Standard / Large & Medium Desktop & Tablet Layout -->
            <Grid Visibility="{x:Bind GetStandardDesktopViewVisibility(ViewModel.CurrentBreakpoint), Mode=OneWay}"
                  RowDefinitions="Auto,*">
                
                <!-- Adaptive Header Bar -->
                <views:AdaptiveHeaderBar Grid.Row="0" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

                <!-- Main Work Area: Left Sidebar (Track Card) + Right (Lyrics Stage) -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="{x:Bind GetColumnSpacing(ViewModel.CurrentBreakpoint), Mode=OneWay}">
                    
                    <!-- Left Rail: Track Metadata & Controls Card -->
                    <views:AdaptiveTrackCard Grid.Column="0"
                                            Width="{x:Bind ViewModel.SidePanelWidth, Mode=OneWay}"
                                            ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

                    <!-- Right Stage: Real-Time Karaoke Lyrics Stage -->
                    <views:LyricsStageView x:Name="StandardLyricsStage"
                                          Grid.Column="1"
                                          ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- Small / Mobile Responsive Layout -->
            <Grid Visibility="{x:Bind GetMobileViewVisibility(ViewModel.CurrentBreakpoint), Mode=OneWay}"
                  RowDefinitions="Auto,*,Auto">
                
                <!-- Mobile Compact Header -->
                <views:AdaptiveHeaderBar Grid.Row="0" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

                <!-- Mobile Active View Switcher -->
                <Grid Grid.Row="1">
                    <!-- Tab 1: Lyrics Mode with Compact Top Strip -->
                    <Grid Visibility="{x:Bind GetMobileLyricsVisibility(ViewModel.MobileView), Mode=OneWay}"
                          RowDefinitions="Auto,*"
                          RowSpacing="10">
                        <views:AdaptiveTrackCard Grid.Row="0" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                        <views:LyricsStageView x:Name="MobileLyricsStage" Grid.Row="1" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                    </Grid>

                    <!-- Tab 2: Full Track / Now Playing Mode -->
                    <Grid Visibility="{x:Bind GetMobileNowPlayingVisibility(ViewModel.MobileView), Mode=OneWay}">
                        <views:AdaptiveTrackCard ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                    </Grid>

                    <!-- Tab 3: Settings & Precision Sync Mode -->
                    <Grid Visibility="{x:Bind GetMobileSettingsVisibility(ViewModel.MobileView), Mode=OneWay}">
                        <views:MobileSettingsView ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                    </Grid>
                </Grid>

                <!-- Mobile Bottom Navigation Bar -->
                <views:MobileTabBar Grid.Row="2" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
            </Grid>

            <!-- Fullscreen / 10-Foot TV Kiosk Presentation Mode -->
            <Grid Visibility="{x:Bind GetKioskViewVisibility(ViewModel.CurrentBreakpoint), Mode=OneWay}"
                  RowDefinitions="*,Auto">
                
                <!-- Center-Anchored 10-Foot Lyrics Stage -->
                <views:LyricsStageView x:Name="KioskLyricsStage"
                                      Grid.Row="0"
                                      HorizontalAlignment="Center"
                                      ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

                <!-- Bottom Floating Minimal Telemetry HUD -->
                <views:MiniPlaybackBar Grid.Row="1"
                                      ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                      Margin="0,20,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Page>
