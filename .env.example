# Spotify application credentials (https://developer.spotify.com/dashboard).
# The double underscore maps to the Spotify:ClientId configuration key, which
# is what docker-compose.yml and the server bind. A plain SPOTIFY_CLIENT_ID is
# NOT read by the app.
Spotify__ClientId=your_32_character_client_id

# Optional. Only needed for flows that require a client secret.
# Spotify__ClientSecret=

# The canonical URL browsers and clients use to reach Cantus. Used to resolve
# the Spotify OAuth callback.
CANTUS_HOST_URL=http://localhost:5000
