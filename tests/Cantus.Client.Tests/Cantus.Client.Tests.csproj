<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);CANTUS_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Uno.WinUI" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cantus.Core\Cantus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Cantus.Client\Cantus.Client\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Cantus.Client\Cantus.Client\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Cantus.Client\Cantus.Client\ViewModels\*.cs" Link="ViewModels\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
